#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo '.')"

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
if [ -z "$STAGED_MD" ]; then
    exit 0
fi

GUARD="$REPO_ROOT/scripts/fabrication_guard.py"
if [ ! -f "$GUARD" ]; then
    echo "🔴 FABRICATION GUARD MISSING — $GUARD not found."
    echo "   This is a safety-critical failure. The guard must exist before any commit."
    echo "   Restore scripts/fabrication_guard.py and try again."
    exit 1
fi

echo "▸ Fabrication guard (Level 1) — checking staged files..."
python3 "$GUARD" --level 1 --quick
RET=$?

if [ $RET -ne 0 ]; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🔴 COMMIT BLOCKED — fabrication guard failed (Level 1)"
    echo ""
    echo "   Fix the issues above before committing."
    echo "   Do NOT use --no-verify to bypass this gate."
    echo ""
    echo "   If a legitimate claim is blocked, update the guard:"
    echo "   $GUARD"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    exit 1
fi

echo "  ✓ Level 1 passed"
exit 0
